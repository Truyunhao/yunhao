{
  "manifest_version": 3,
  "name": "液态玻璃 · 新标签页",
  "version": "1.5.4",
  "description": "液态玻璃风格的新标签页：时间、多引擎搜索、多面板分类导航，支持静态壁纸轮播与动态视频壁纸、主题与折射参数调节。",
  "minimum_chrome_version": "100",
  "offline_enabled": true,
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
